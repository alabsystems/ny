; ny install self-test (vnncomp_scripts/selftest/make_selftest.py):
; f(x) = relu(x) + relu(-x) = |x| on the box x in [-1, 1].
; Violation asserted: Y_0 >= 2. max |x| on the box is 1 < 2, so the violation
; is unreachable and the only correct answer is unsat.
(declare-const X_0 Real)
(declare-const Y_0 Real)
(assert (>= X_0 -1))
(assert (<= X_0 1))
(assert (>= Y_0 2))
